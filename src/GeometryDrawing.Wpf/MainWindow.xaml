<Window x:Class="GeometryDrawing.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Геометрические фигуры"
        Width="1180"
        Height="720"
        MinWidth="1060"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Панель фигур" />
                <TextBlock Margin="0,6,0,14"
                           Foreground="#5B6472"
                           Text="Случайные фигуры или точные значения в пикселях."
                           TextWrapping="Wrap" />

                <GroupBox Margin="0,0,0,12" Header="Треугольник">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="X" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="Y" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="P1" />
                            <TextBox x:Name="P1XTextBox" Grid.Row="1" Grid.Column="1" Text="120" />
                            <TextBox x:Name="P1YTextBox" Grid.Row="1" Grid.Column="2" Text="90" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="P2" />
                            <TextBox x:Name="P2XTextBox" Grid.Row="2" Grid.Column="1" Text="300" />
                            <TextBox x:Name="P2YTextBox" Grid.Row="2" Grid.Column="2" Text="100" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="P3" />
                            <TextBox x:Name="P3XTextBox" Grid.Row="3" Grid.Column="1" Text="200" />
                            <TextBox x:Name="P3YTextBox" Grid.Row="3" Grid.Column="2" Text="260" />
                        </Grid>
                        <Button Content="По заданным точкам" Click="ManualTriangle_Click" />
                        <Button Content="Случайный треугольник" Click="RandomTriangle_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,12" Header="Прямоугольник и квадрат">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="X" />
                            <TextBox x:Name="RectangleXTextBox" Grid.Column="1" Text="100" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                            <TextBox x:Name="RectangleYTextBox" Grid.Column="3" Text="100" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Ширина" />
                            <TextBox x:Name="RectangleWidthTextBox" Grid.Row="1" Grid.Column="1" Text="220" />
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Высота" />
                            <TextBox x:Name="RectangleHeightTextBox" Grid.Row="1" Grid.Column="3" Text="140" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="Сторона квадрата" />
                            <TextBox x:Name="SquareSideTextBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="150" />
                        </Grid>
                        <Button Content="Заданный прямоугольник" Click="ManualRectangle_Click" />
                        <Button Content="Заданный квадрат" Click="ManualSquare_Click" />
                        <Button Content="Случайный прямоугольник" Click="RandomRectangle_Click" />
                        <Button Content="Случайный квадрат" Click="RandomSquare_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,12" Header="Перемещение">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="ΔX" />
                            <TextBox x:Name="MoveXTextBox" Grid.Column="1" Text="10" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="ΔY" />
                            <TextBox x:Name="MoveYTextBox" Grid.Column="3" Text="10" />
                        </Grid>
                        <Button Content="Переместить на ΔX и ΔY" Click="MoveFigure_Click" />
                        <Grid Margin="68,4,68,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Column="1" Content="↑" Tag="0;-10" Click="NudgeFigure_Click" />
                            <Button Grid.Row="1" Content="←" Tag="-10;0" Click="NudgeFigure_Click" />
                            <Button Grid.Row="1" Grid.Column="1" Content="↓" Tag="0;10" Click="NudgeFigure_Click" />
                            <Button Grid.Row="1" Grid.Column="2" Content="→" Tag="10;0" Click="NudgeFigure_Click" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,12" Header="Оформление фигуры">
                    <StackPanel Margin="10">
                        <TextBlock Text="Цвет линий" />
                        <ComboBox x:Name="LineColorComboBox"
                                  Height="30"
                                  Margin="0,4,0,10"
                                  SelectedIndex="0">
                            <ComboBoxItem Tag="IndianRed" Content="Красный" />
                            <ComboBoxItem Tag="RoyalBlue" Content="Синий" />
                            <ComboBoxItem Tag="SeaGreen" Content="Зелёный" />
                            <ComboBoxItem Tag="DarkViolet" Content="Фиолетовый" />
                            <ComboBoxItem Tag="Black" Content="Чёрный" />
                        </ComboBox>

                        <DockPanel>
                            <TextBlock VerticalAlignment="Center" Text="Толщина линий" />
                            <TextBlock Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding ElementName=StrokeThicknessSlider, Path=Value, StringFormat={}{0:0}}" />
                        </DockPanel>
                        <Slider x:Name="StrokeThicknessSlider"
                                Margin="0,6,0,0"
                                Minimum="1"
                                Maximum="10"
                                Value="3"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True" />
                    </StackPanel>
                </GroupBox>

                <Button Content="Очистить холст" Click="ClearScene_Click" />
                <Border Margin="0,12,0,0" Padding="10" Background="#EEF2FF" CornerRadius="6">
                    <TextBlock x:Name="StatusText"
                               Foreground="#334155"
                               Text="Выберите фигуру."
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="8">
            <Canvas x:Name="Scene"
                    Width="680"
                    Height="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F8FAFC" />
        </Border>
    </Grid>
</Window>
